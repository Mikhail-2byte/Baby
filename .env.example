# Настройки Baby Bot. Скопируйте в `.env` и заполните.
#
# Это не список ключей, а документация: у каждой строки записано, почему
# значение именно такое и что сломается, если его поменять. Формат унаследован
# от Family_planer и оправдал себя — через полгода «а почему тут 90?» задаёт
# сам себе тот же человек, который это писал.
#
# Две идиомы:
#   0            = функция выключена
#   пустая строка = работаем напрямую / без вендора


# ============================================================================
# ОБЯЗАТЕЛЬНОЕ
# ============================================================================

# Токен у @BotFather. ОТДЕЛЬНЫЙ от Family_planer — это не перестраховка:
# два long polling на одном токене не падают и не ругаются, они молча делят
# апдейты между собой, и часть записей о кормлении просто исчезает.
#
# В настройках бота у BotFather обязательно выключите Group Privacy
# (/mybots → Bot Settings → Group Privacy → Turn off), иначе бот не увидит
# в группе ничего, кроме команд, и ответ числом на «сколько мл?» не дойдёт.
BOT_TOKEN=

# ============================================================================
# ГДЕ ЛЕЖАТ ДАННЫЕ
# ============================================================================

# Файл базы. Рядом с ним селятся bot.log, heartbeat и каталог backups/ —
# отдельных настроек у них нет намеренно, иначе половина данных однажды
# окажется в одном месте, а половина в другом.
#
# Менять стоит разве что ради переноса на другой диск. Путь относительный —
# значит, от каталога запуска, а бот запускается только из корня проекта
# (см. шапку bot/config.py)
DB_PATH=data/baby.db

# ============================================================================
# ВРЕМЯ
# ============================================================================

# Таймзона по умолчанию для новых семей. В БД всё лежит в UTC, эта строка
# применяется только на границе ввода и вывода
TZ_DEFAULT=Europe/Moscow

# Период фонового цикла. Реже 60 с делать не стоит: напоминание о кормлении
# с точностью до пяти минут — это уже не напоминание
TICK_SECONDS=60

# ============================================================================
# НАПОМИНАНИЯ: ДОГОНКА ПОСЛЕ СПЯЩЕГО ПК
# ============================================================================

# Три ступени опоздания. Меньше LATE_SILENT_MIN — шлём как есть; меньше
# LATE_SUMMARY_HOURS — с пометкой «было запланировано на»; дольше — одной
# сводкой.
#
# Именно ради третьей ступени всё и затевалось. Домашний ПК уходит в сон, а
# напоминания о кормлении идут раз в 2-3 часа: без сворачивания после
# шестичасового сна машины семья получила бы восемь одинаковых уведомлений
# в одну секунду, и все восемь бесполезные
LATE_SILENT_MIN=10
LATE_SUMMARY_HOURS=12

# ============================================================================
# ПАНЕЛЬ
# ============================================================================

# Дебаунс: серия быстрых тапов склеивается в одно редактирование. Не только
# ради тишины в логе — Telegram ограничивает частоту правок одного сообщения,
# и без дебаунса серия тапов упирается во флуд-контроль
PANEL_DEBOUNCE_SECONDS=1.5

# После скольких чужих сообщений панель считается уехавшей вверх и
# перевыпускается заново
PANEL_MAX_MESSAGES=15

# ============================================================================
# ТРЕКЕР
# ============================================================================

# Через сколько часов незакрытый таймер кормления или сна считать забытым.
# Тикер закроет его сам и пометит длительность как приблизительную.
#
# Закрывать обязательно: открытый таймер ломает статистику суток целиком.
# Забыть вторую кнопку в три часа ночи — норма, а не исключение
OPEN_TIMER_MAX_HOURS=4

# Недельный дайджест: день недели (0 = понедельник) и локальное время
DIGEST_DOW=0
DIGEST_TIME=10:00

# ============================================================================
# ПЕРИОДИЧЕСКИЙ ОПРОС «ЧТО БЫЛО С ПРОШЛОГО РАЗА?»
# ============================================================================
#
# Настроек здесь нет, и это решение, а не недосмотр. Строка вида
# CHECKIN_HOURS=3 включила бы опрос сразу всем семьям — то есть сделала бы
# ровно то, чего проект не делает: бот молчит, пока его не попросили, и
# особенно молчит тот бот, который начинает задавать вопросы сам.
#
# Интервал и «включён ли» живут в БД, по семье, и включаются тапом в /remind;
# выключено по умолчанию. Всё остальное — интервалы на выбор, границы ночного
# окна, виды на карточке и сдвиги «когда» — в bot/content/checkin_ru.yaml.

# ============================================================================
# БЭКАПЫ
# ============================================================================

# Сколько снимков держать в data/backups/. 0 = ежедневный выключен,
# но /backup работает.
#
# Две недели, а не одна: вес и кормления за первый год ребёнка
# невосстановимы. Это единственные данные в проекте, которые нельзя
# получить заново ни при каких условиях
BACKUP_KEEP=14

# ============================================================================
# БАЗА ЗНАНИЙ
# ============================================================================

# Отдельный файл, а не таблица в baby.db. База знаний пересобирается одной
# командой из документов, а вес и кормления за первый год не восстанавливаются
# ничем — смешивать их нельзя. Отсюда же: kb.db не попадает ни в суточные
# снимки, ни в файл, который присылает /backup.
#
# Собрать:  .venv\Scripts\python kbuild_kb.py
# Проверить: .venv\Scripts\python kb\eval_kb.py
#
# Без собранной базы бот работает как раньше, просто не отвечает на вопросы
KB_PATH=data/kb.db

# Сколько фрагментов уходит в ответ. Больше пяти никто не читает
KB_TOP_K=5

# Когда считать, что не нашли. KB_MIN_COVERAGE — какую долю значимых слов
# вопроса обязан покрыть фрагмент; KB_STOPWORD_DF — с какой частоты слово
# считается служебным и в расчёт не идёт.
#
# Значения подобраны по оценочному набору из kb/eval.yaml, а не на глаз:
# при 0.5 и 0.25 выходит recall@5 = 0.83. Прежде чем менять — прогоните
# kb/eval_kb.py и сравните, иначе это обмен одних промахов на другие вслепую
KB_MIN_COVERAGE=0.5
KB_STOPWORD_DF=0.25

# ============================================================================
# LLM (этапы 6-7, пока можно оставить пустым)
# ============================================================================

# Цепочка моделей через запятую, в порядке перебора. Формат `вендор:модель`.
#
# Смысл списка — независимость отказов, а не качество. Урок Family_planer:
# 01.09.2026 разбор встал целиком на 401 от GMICloud, единственного провайдера
# бесплатной модели. Поэтому соседние звенья берём у РАЗНЫХ вендоров, а не
# у разных провайдеров внутри одного OpenRouter.
#
# Имена моделей сверяйте не по документации провайдера, а У СВОЕГО АККАУНТА:
# список в документах и список, доступный ключу, — разные вещи. Проверено
# фактом: `llama-3.3-70b-versatile` из документации Groq дала 404 «does not
# exist or you do not have access to it», и llama у аккаунта не оказалось
# вообще ни одной. Спрашивать так:
#
#   curl -H "Authorization: Bearer $KEY" https://api.groq.com/openai/v1/models
#
# Для OpenRouter — openrouter.ai/models. Имена меняются чаще, чем хотелось бы.
#
# С этапа 7 эта строка нужна и для разбора голосовых. Заполнить только
# LLM_ANSWER_MODELS не выйдет: ответы по базе знаний будут работать, а разбор
# голоса — отвечать «нет модели» всем и всегда. Порядок именно такой потому,
# что дорогая модель для медицинских ответов не должна тратиться на
# «покормила 20 минут»
LLM_MODELS=

# Модель для медицинских ответов по базе знаний. Отдельно от LLM_MODELS,
# потому что цена ошибки разная: разобрать «покормили 20 минут» может кто
# угодно, отвечать на вопрос о ребёнке — нет.
# Пусто = берём первую из LLM_MODELS
LLM_ANSWER_MODELS=

# ---------------------------------------------------------------------------
# ПЛОТНЫЙ ПОИСК ПО БАЗЕ ЗНАНИЙ
# ---------------------------------------------------------------------------

# Модель, которой считается смысл фрагмента и вопроса. Считается через
# POST /api/v1/embeddings у OpenRouter — тем же ключом, что и ответы.
#
# Заведено 19.09.2026. До него поиск был только по словам, и замер показал,
# чего это стоит: верный фрагмент лежал в сорока кандидатах у 94% вопросов, а
# первым местом выходил у 60%. Четыре способа пересортировать это той же
# арифметикой дали в лучшем случае четыре пункта.
#
# Локальную модель здесь держать не надо: 15.09.2026 её отклонили за 2.5 ГБ у
# процесса, который работает круглосуточно. Через API в памяти остаётся только
# матрица векторов — около трёх мегабайт.
#
# ВАЖНО: векторы двух разных моделей несравнимы. Сменив эту строку, надо
# пересобрать базу; до пересборки бот сам выключит плотный поиск и скажет об
# этом в лог. Пусто = поиск только по словам, как до 19.09.2026
EMBED_MODEL=baai/bge-m3

# Пусто = берём ключ и прокси OpenRouter. Отдельные строки нужны не ради
# второго секрета, а ради возможности выключить плотный поиск, не трогая Q&A
EMBED_KEY=
EMBED_PROXY=

# По сколько фрагментов уходит в один запрос при сборке базы. Две тысячи по
# одному — это две тысячи запросов и верный 429; пачками по 64 их тридцать три
EMBED_BATCH=64

# Пол по косинусу: ниже него фрагмент в плотную выдачу не попадает. Плотный
# поиск молчать не умеет — ближайший по смыслу кусок найдётся и для вопроса
# про биткоин, — и это единственная ручка, которой его можно приглушить.
#
# Значение выбирается замером, а не на глаз: у прошлой такой ручки между
# соседними значениями recall прыгал на тринадцать пунктов, и её за это
# отклонили. Кривая лежит в docs/TASKS.md. 0 = пола нет
KB_MIN_SIMILARITY=0.50

OPENROUTER_KEY=
GROQ_KEY=

# Сколько запросов к моделям в сутки себе позволяем — на всю цепочку разом.
# Считаем сами: провайдер о приближении к лимиту не предупреждает, он просто
# начинает отвечать 429. 0 = не ограничивать.
#
# Важно: суточные лимиты OpenRouter считаются НА АККАУНТ, а не на ключ.
# Этот бот будет есть ту же квоту, что и Family_planer
LLM_DAILY_LIMIT=300

# ============================================================================
# ГОЛОСОВЫЕ (этап 7)
# ============================================================================

# Whisper-совместимый эндпоинт Groq принимает ogg/opus Telegram как есть,
# поэтому ffmpeg проекту не нужен.
#
# Пустой ключ = голос выключен целиком. Бот скажет об этом один раз на чат и
# дальше будет молчать на голосовые — отвечать на каждую реплику семьи «нет
# ключа» хуже, чем молчать.
#
# Заполненный ключ означает, что КАЖДАЯ голосовая реплика этого чата уходит в
# Groq, включая ту, что боту не адресована: кнопки-приглашения здесь нет
# намеренно, иначе лишний тап перед каждой записью отменяет весь смысл говорить
# вслух.
#
# И важная оговорка: без расшифровки нет и триажа. Тревожные признаки,
# сказанные голосом, при пустом ключе не перехватывает ничто
STT_KEY=
STT_MODEL=whisper-large-v3-turbo
STT_URL=https://api.groq.com/openai/v1/audio/transcriptions
VOICE_MAX_SECONDS=120

# ============================================================================
# ПРОКСИ
# ============================================================================

# Пустое значение = напрямую. Прокси нужен из-за недоступности
# api.telegram.org из России: с весны 2026 это не замедление, а блокировка.
#
# Порт тот же, что у Family_planer — там уже настроен Karing на
# 127.0.0.1:3067. Он нестабилен (в живом логе планировщика сотни
# ProxyConnectionError за сутки), но aiogram переподключается сам.
#
# По одной настройке на канал: у вендоров бывают разные маршруты, и сводить
# их в одну строку — верный способ однажды не понять, что именно отвалилось
TELEGRAM_PROXY=http://127.0.0.1:3067
OPENROUTER_PROXY=http://127.0.0.1:3067
GROQ_PROXY=http://127.0.0.1:3067
STT_PROXY=http://127.0.0.1:3067
